# ── TrendPulse env template ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env or secrets/.
# Phase that needs each value is noted in brackets.

# Server [Phase 0]
PORT=4317
HOST=127.0.0.1
TZ=UTC
DASHBOARD_PASSWORD=
LOG_LEVEL=info

# Schedule [Phase 6]
SCHEDULE_CRON=0 6 * * *
RUN_MISSED_ON_START=true
AUTO_RESUME=false

# Google Sheets [Phase 1] — docs/15 wins: Composio is default (key + connect click)
SHEETS_MODE=composio
SHEETS_READ_STRATEGY=mirror
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=trendpulse-local
COMPOSIO_GOOGLESHEETS_AUTH_CONFIG_ID=
COMPOSIO_MONTHLY_CALL_BUDGET=15000
COMPOSIO_CALL_TIMEOUT_MS=60000
# Advanced only: service account JSON (needs sheet shared with its email)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/service-account.json
GOOGLE_SHEET_ID=
SHEET_CACHE_TTL_S=60

# OmniRoute — LLM gateway, OpenAI-compatible [Phase 2]
# OmniRoute does NOT fetch web pages; collectors fetch with plain HTTP.
# Writer model writes topic text + digest; fallback model answers Jev-typed questions when Jev is down.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_EXTRACT_MODEL=
OMNIROUTE_WRITER_MODEL=
OMNIROUTE_FALLBACK_MODEL=

# Jev — typed classifier only, never writes text [Phase 2/5]
# Direct default is https://api.typesafe.ai + /v1/systemone with model jev-latest.
# Leave JEV_BASE_URL empty to route Jev calls through OmniRoute (local-only setups).
JEV_BASE_URL=
JEV_PATH=/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_CONCURRENCY=8
JEV_PRICE_PER_M_INPUT=0.04
JEV_RUN_BUDGET_USD=1.00
JEV_FALLBACK=true
QUALITY_MIN=0.5
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=90000

# Collection [Phase 3]
TRENDS_GEO=US
NICHES=
MAX_ITEMS_PER_SOURCE=50
DEDUPE_DAYS=3
USER_AGENT=TrendPulse/1.0 (+local)
ENABLE_PLAYWRIGHT=false

# Scrapling-lite sidecar [Stretch S1, opt-in]
# Spawns scrapling-service/ (127.0.0.1:4318) for webpage fetches with a
# per-boot token; falls back to native fetch when down.
SCRAPLING_ENABLED=false
SCRAPLING_URL=http://127.0.0.1:4318

# Optional source keys [Phase 3]
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=

# Sorting and data [Phase 5/6]
SORT_BATCH_SIZE=30
TOP_N=50
RETENTION_DAYS=30
RETENTION_MODE=archive
