{
  "name": "@trendpulse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "setup": "tsx scripts/setup.ts",
    "collect": "tsx scripts/collect.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "sheets:init": "tsx scripts/sheets-init.ts",
    "pipeline": "tsx scripts/run.ts",
    "rebuild-state": "tsx scripts/rebuild-state.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@mozilla/readability": "^0.6.0",
    "@trendpulse/shared": "0.1.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "googleapis": "^182.0.0",
    "jsdom": "^30.1.1",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^3.0.0"
  }
}
